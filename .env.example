# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real credentials.

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
# Supabase dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Safe to expose to the browser.
# Supabase dashboard -> Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER ONLY - never prefix this with NEXT_PUBLIC_.
# Used by the API routes and the scheduled job so writes work even with
# row level security enabled. Supabase dashboard -> Project Settings -> API ->
# Project API keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic --------------------------------------------------------------
# Claude API key used by the on-demand "Recommend Next Action" route.
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
